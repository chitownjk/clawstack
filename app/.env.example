# =============================================================================
# Tiker Environment Variables
# Copy this file to .env.local and fill in the values
# =============================================================================

# --- Core (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ENCRYPTION_KEY=your-random-encryption-key-at-least-32-chars
ANTHROPIC_API_KEY=sk-ant-...

# --- Auth ---
# Options: 'supabase' (default, Google SSO), 'local' (no auth), 'password' (simple password)
AUTH_MODE=supabase
NEXTAUTH_SECRET=your-random-secret
# Only needed if AUTH_MODE=password
# LOCAL_ADMIN_PASSWORD=

# Google OAuth (needed if AUTH_MODE=supabase)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App Config ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Options: 'consumer' or 'developer'
NEXT_PUBLIC_PRODUCT_MODE=consumer

# --- Composio (for integrations) ---
COMPOSIO_API_KEY=

# --- Bonnie Internal API (optional, private) ---
BONNIE_INTERNAL_API_KEY=
BONNIE_INTERNAL_ACCOUNT_EMAIL=jklauminzer@gmail.com

# --- Cron Jobs ---
# Required for /api/briefing/cron to work
CRON_SECRET=your-cron-secret

# --- Email (SMTP) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com

# --- Stripe (payments) ---
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_TEAM_PRICE_ID=price_...

# --- Push Notifications (optional) ---
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- Voice/Phone (optional) ---
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_URL=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# --- Plaid (optional, financial) ---
# PLAID_CLIENT_ID=
# PLAID_SECRET=

# --- GitHub OAuth (optional) ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Cloudflare (optional) ---
# CLOUDFLARE_WEBHOOK_SECRET=
